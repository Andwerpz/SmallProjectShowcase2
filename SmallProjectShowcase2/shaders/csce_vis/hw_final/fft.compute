#version 430 core
#define M_PI 3.1415926535897932384626433832795

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D inputt;
uniform bool workRow;
uniform bool invert;

shared vec2 arr[2][256];
int f = 0;
int t = 1;

vec2 mult(vec2 a, vec2 b) {
    return vec2(a[0] * b[0] - a[1] * b[1], a[0] * b[1] + a[1] * b[0]);
}

void fft(const int n, const int i) {
    const int LOG_N = int(round(log2(n)));
    const int MINUS_SIDE = 1 << (LOG_N - 1);
    const int INVERSION = invert ? -1 : 1;

    barrier();

    for (int l = LOG_N - 1; l >= 0; --l) {

        const int SIZE = 1 << (LOG_N - l);
        const int MINI_MOVEMENT = 1 << l;

        const int index = (i & (MINUS_SIDE-1)) >> l;

        float rad = INVERSION * 2 * M_PI * index / SIZE;
        vec2 toMult = vec2(cos(rad), sin(rad));

        const int group = i & (MINI_MOVEMENT-1);

        const int MOVEMENT = index << (l+1);

        const int i2 = group + MOVEMENT;
        const int i3 = group + MOVEMENT + MINI_MOVEMENT;

        if ((i & MINUS_SIDE) == 0)
        	arr[t][i] = arr[f][i2] + mult(toMult, arr[f][i3]);
        else
        	arr[t][i] = arr[f][i2] - mult(toMult, arr[f][i3]);

        barrier();

        t ^= 1;
        f ^= 1;
    }
}

void main() {

    // get the row (id) and specific index (i)
    const uint id = gl_WorkGroupID[0];
    const int i = int(gl_LocalInvocationID[0]);

    // images are n x n
    const int n = imageSize(inputt)[0];

    // copy input into the temp image
    if (workRow)
        arr[0][i] = imageLoad(inputt, ivec2(id, i)).rg;
    else
        arr[0][i] = imageLoad(inputt, ivec2(i, id)).rg;

    // parallel fft
    fft(n, i);

    // offset shift
    const int m = i;
    vec2 u = arr[f][m];
    vec2 toMult = vec2(cos(-2 * M_PI * (m - n / 2) / 2), sin(-2 * M_PI * (m - n / 2) / 2));
    arr[f][m] = mult(toMult, u);
    
    // move temp back into the output image
    if (workRow)
        imageStore(inputt, ivec2(id, i), vec4(arr[f][i], 0, 0));
    else
        imageStore(inputt, ivec2(i, id), vec4(arr[f][i], 0, 0));
}